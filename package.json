{
  "name": "ecopulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test:core": "node --experimental-strip-types --test tests/*.test.ts",
    "test": "npm run test:core",
    "check": "npm run test && npm run typecheck",
    "check:core": "npm run test && npm run typecheck:core",
    "verify:release": "npm run check && npm run build"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.3"
  },
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  }
}
